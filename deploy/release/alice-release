#!/usr/bin/env bash
# Company-side release tooling. The private key never goes on a customer device; only release.pub does.
#   alice-release keygen <dir>
#   alice-release bundle  --key K --image TAG --version X.Y.Z --out DIR [--emergency --reason TEXT] [--notes TEXT] [--days N] [--min-version V]
#   alice-release publish --key K --image REPO@sha256:DIGEST --version X.Y.Z --out DIR [same options]   (registry release, no image file)
set -euo pipefail
cmd="${1:-}"; shift || true
die() { echo "error: $*" >&2; exit 1; }

sign() { openssl pkeyutl -sign -inkey "$1" -rawin -in "$2" -out "$2.sig"; }

case "$cmd" in
keygen)
  d="${1:?usage: keygen <dir>}"; mkdir -p "$d"; umask 077
  openssl genpkey -algorithm ed25519 -out "$d/release.key"
  openssl pkey -in "$d/release.key" -pubout -out "$d/release.pub"
  echo "Wrote $d/release.key (keep offline) and $d/release.pub (install as /etc/alice/release.pub)";;
bundle|publish)
  key= image= version= out= emergency=false reason= notes= days=30 minv=0.0.0
  while [ $# -gt 0 ]; do case "$1" in
    --key) key=$2; shift 2;; --image) image=$2; shift 2;; --version) version=$2; shift 2;; --out) out=$2; shift 2;;
    --emergency) emergency=true; shift;; --reason) reason=$2; shift 2;; --notes) notes=$2; shift 2;;
    --days) days=$2; shift 2;; --min-version) minv=$2; shift 2;; *) die "unknown option $1";; esac; done
  [ -n "$key" ] && [ -n "$image" ] && [ -n "$version" ] && [ -n "$out" ] || die "missing option"
  [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || die "version must be X.Y.Z"
  mkdir -p "$out"
  created=$(date -u +%Y-%m-%dT%H:%M:%SZ); expires=$(date -u -d "+$days days" +%Y-%m-%dT%H:%M:%SZ)
  if [ "$cmd" = bundle ]; then
    docker save "$image" -o "$out/image.tar"
    id=$(docker image inspect --format '{{.Id}}' "$image")
    tarsha=$(sha256sum "$out/image.tar" | cut -d' ' -f1)
    jq -n --arg v "$version" --arg c "$created" --arg e "$expires" --arg tag "$image" --arg id "$id" --arg ts "$tarsha" \
      --argjson em "$emergency" --arg r "$reason" --arg n "$notes" --arg m "$minv" \
      '{product:"alice",version:$v,created:$c,expires:$e,emergency:$em,reason:$r,notes:$n,minVersion:$m,imageTag:$tag,imageId:$id,bundle:{file:"image.tar",sha256:$ts}}' > "$out/manifest.json"
  else
    [[ "$image" =~ @sha256:[0-9a-f]{64}$ ]] || die "registry images must be pinned by digest (repo@sha256:...)"
    jq -n --arg v "$version" --arg c "$created" --arg e "$expires" --arg img "$image" \
      --argjson em "$emergency" --arg r "$reason" --arg n "$notes" --arg m "$minv" \
      '{product:"alice",version:$v,created:$c,expires:$e,emergency:$em,reason:$r,notes:$n,minVersion:$m,image:$img}' > "$out/manifest.json"
  fi
  sign "$key" "$out/manifest.json"
  echo "Wrote $out/manifest.json and .sig";;
*) sed -n 2,6p "$0"; exit 1;;
esac
